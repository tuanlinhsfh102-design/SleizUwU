DATABASE_URL=./data/sleiz.db
STORAGE_DIR=./data/storage
API_PORT=8787

# AI keys (optional — can also be set in Settings UI)
GEMINI_API_KEY=

# MongoDB workspace sync
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?appName=Cluster0

# Private GitHub releases for auto-update
GITHUB_PRIVATE_REPO=owner/repo
GITHUB_PRIVATE_TOKEN=ghp_xxx

# ─── Supabase Realtime (broadcast sync across clients) ─────────────────────
# Backend uses secret key to broadcast; frontend uses publishable key to subscribe.
# Create a free project at https://supabase.com → Project Settings → API.
# Realtime Broadcast works out of the box — no DB migration required.
#
# New Supabase key format (Aug 2026+):
#   - sb_publishable_...  (was: anon public key, eyJ...)
#   - sb_secret_...       (was: service_role key, eyJ...)
# Both old and new formats work in @supabase/supabase-js ^2.110.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Frontend (Vite) — exposed to browser. Use the publishable key only.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
